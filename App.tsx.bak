                        <span className="text-[9px] font-mono text-neutral-400 uppercase block">{k}</span>
                        <span className="text-[11px] font-mono text-emerald-300 block truncate mt-0.5">{String(v)}</span>
                      </div>
                    ))}
                  </div>
                )}

