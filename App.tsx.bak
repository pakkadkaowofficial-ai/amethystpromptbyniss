                >
                  <span>Explore 6 Dimensions</span>
                  <span className="text-neutral-500 font-sans">→</span>
                </a>

                <button
                  onClick={() => setIsDeckOpen(true)}
                  className="px-7 py-3.5 rounded-full text-xs font-mono uppercase tracking-widest text-neutral-300 hover:text-white bg-white/[0.02] hover:bg-white/[0.06] border border-white/[0.08] hover:border-purple-500/40 backdrop-blur-xl transition-all duration-300 inline-flex items-center gap-2"
                >
                  <Presentation className="w-3.5 h-3.5 text-purple-400" />
                  <span>Launch Slide Deck</span>
                </button>
              </div>

            </div>

            {/* Right Showcase Column: Floating Architectural Focal Card */}
            <div className="lg:col-span-6">
              <div 
                className="relative rounded-3xl p-8 lg:p-10 bg-white/[0.02] border border-white/[0.08] backdrop-blur-2xl shadow-2xl group select-none cursor-grab active:cursor-grabbing overflow-hidden"
                onMouseDown={handleMouseDown}
                onMouseMove={handleMouseMove}
                onMouseUp={handleMouseUp}
                onMouseLeave={handleMouseUp}
                onTouchStart={handleTouchStart}
                onTouchMove={handleTouchMove}
                onTouchEnd={handleMouseUp}
              >
                {/* Soft Diffused CSS Radial Backlight (Chiaroscuro Studio Lighting) */}
                <div 
                  className={`absolute -inset-10 pointer-events-none diffused-radial-backlight transition-all duration-700 ${isPulseActive ? 'animate-chiaroscuro' : 'opacity-25'}`}
                />

                {/* Hardware Header Badges */}
                <div className="relative z-10 flex items-center justify-between mb-4">
                  <div className="flex items-center gap-2.5">
                    <span className="text-[10px] font-mono tracking-widest uppercase px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-neutral-300 flex items-center gap-1.5">
                      <RotateCcw className="w-3 h-3 text-purple-400" />
                      <span>360° Inspection Canvas</span>
                    </span>
                    <span className="text-[11px] font-mono text-purple-300 tracking-wider">
                      Angle: {Math.round(((rotationAngle % 360) + 360) % 360)}°
                    </span>
                  </div>
                  <button
                    onClick={() => setIsPulseActive(!isPulseActive)}
                    className="text-[10px] font-mono uppercase tracking-widest px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] hover:border-purple-500/30 text-neutral-300 transition-colors"
                  >
                    {isPulseActive ? 'Backlight: Active' : 'Backlight: Static'}
