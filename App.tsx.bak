                {/* Spotlight Hardware Display Area */}
                <div className="relative z-10 w-full h-[400px] sm:h-[460px] flex flex-col items-center justify-center">
                  
                  {/* Physical Hardware Graphic Container with WebP and Fallback */}
                  <div 
