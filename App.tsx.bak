                >
                  <ExternalLink className="w-3.5 h-3.5 text-purple-400" />
                  <span>Open PDF Direct</span>
                </a>
              </div>

            </div>

            {/* Quick Slide Index Strip */}
            <div className="relative z-10 mt-10 pt-6 border-t border-white/[0.06] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
              {[
                { dim: 'Dim 1', name: 'AI Image (CMF)', range: 'Slides 01–05' },
                { dim: 'Dim 2', name: 'Desmos Math', range: 'Slides 06–10' },
                { dim: 'Dim 3', name: 'Mermaid Arch', range: 'Slides 11–15' },
                { dim: 'Dim 4', name: 'LaTeX IEEE', range: 'Slides 16–20' },
                { dim: 'Dim 5', name: 'NotebookLM', range: 'Slides 21–25' },
                { dim: 'Dim 6', name: 'Interactive Web', range: 'Slides 26–30' }
              ].map((item, idx) => (
                <button
                  key={item.dim}
                  onClick={() => {
                    setCurrentSlideIndex(idx * 5);
                    setIsDeckOpen(true);
                  }}
                  className="text-left p-3 rounded-xl bg-black/40 border border-white/[0.06] hover:border-purple-500/30 transition-colors"
                >
                  <span className="text-[9px] font-mono text-purple-400 block">{item.dim} // {item.range}</span>
                  <span className="text-xs font-display text-neutral-200 block truncate mt-0.5">{item.name}</span>
                </button>
              ))}
            </div>

          </div>

        </div>
      </section>

      {/* ======================================================================
          TECHNICAL SPECIFICATIONS BENTO GRID (LEICA / B&O CMF)
          ====================================================================== */}
      <section id="specifications" className="py-28 lg:py-36 bg-[#050409] border-t border-white/[0.06]">
        <div className="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          
          <div className="max-w-3xl mb-16 space-y-4">
            <div className="flex items-center gap-3">
              <span className="w-6 h-[1px] bg-purple-500/60 inline-block"></span>
              <span className="text-[11px] font-mono uppercase tracking-[0.3em] text-purple-300">HARDWARE CMF // SECTION 04</span>
            </div>
            <h2 className="text-3xl sm:text-4xl lg:text-5xl font-display font-light text-white tracking-[-0.02em]">
              Technical Specifications &amp; Material Matrix
            </h2>
            <p className="text-neutral-400 text-sm sm:text-base font-sans font-light leading-relaxed">
              Four-pillar bento architecture detailing mineral cavity acoustics, cold cavitation electronics, aerospace CNC metallurgy, and autonomous edge sensing.
            </p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            {BENTO_SPECS.map((item) => (
              <div 
                key={item.id}
                className="p-7 sm:p-9 rounded-3xl bg-white/[0.02] border border-white/[0.08] hover:border-purple-500/30 transition-all duration-400 shadow-2xl backdrop-blur-2xl flex flex-col justify-between group"
              >
                <div className="space-y-4">
                  <div className="flex items-center justify-between">
                    <span className="text-2xl">{item.iconGlyph}</span>
                    <span className="text-[10px] font-mono px-3 py-1 rounded-full bg-purple-950/60 border border-purple-500/30 text-purple-300 tracking-wider">
                      {item.metricBadge}
                    </span>
                  </div>
                  <div>
                    <h3 className="text-xl font-display font-medium text-white group-hover:text-purple-200 transition-colors">
                      {item.title}
                    </h3>
                    <p className="text-xs font-mono text-neutral-400 mt-0.5">{item.subtitle}</p>
                  </div>
                  <p className="text-xs text-neutral-300 font-sans font-light leading-relaxed">
                    {item.description}
                  </p>
                  <div className="grid grid-cols-2 gap-2.5 pt-3 border-t border-white/[0.06]">
                    {item.specs.map((spec: { label: string; value: string }) => (
                      <div key={spec.label} className="p-3 rounded-xl bg-black/40 border border-white/[0.04]">
                        <span className="text-[9px] font-mono text-neutral-400 uppercase tracking-wider block">{spec.label}</span>
                        <span className="text-xs font-mono font-medium text-neutral-200 block truncate mt-0.5">{spec.value}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <div className="mt-6 pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono text-purple-400/90">
                  <span>{item.highlightText}</span>
                  <span>→ Verified Spec</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      {/* ======================================================================
          FULLSCREEN EXECUTIVE PRESENTATION DECK MODAL (30 SLIDES)
          ====================================================================== */}
      {isDeckOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/95 backdrop-blur-3xl animate-fadeIn">
          <div className="relative w-full max-w-5xl bg-[#0A0812] border border-purple-500/30 rounded-3xl p-6 sm:p-10 shadow-2xl flex flex-col justify-between min-h-[620px] max-h-[92vh] overflow-y-auto">
            
            {/* Modal Header */}
            <div className="flex items-center justify-between border-b border-white/[0.06] pb-4">
              <div className="flex items-center gap-3">
                <span className="text-[10px] font-mono uppercase tracking-widest px-3 py-1 rounded-full bg-purple-950/60 border border-purple-500/40 text-purple-300 font-semibold">
                  {currentSlide.badge}
                </span>
                <span className="text-xs font-mono text-neutral-400">
                  Slide {currentSlide.slideNumber} of {DECK_SLIDES.length}
                </span>
                <span className="hidden sm:inline-block text-[11px] font-mono text-neutral-500">
                  • {currentSlide.dimensionTitle}
                </span>
              </div>
              
              <div className="flex items-center gap-2">
                <button
                  onClick={() => setIsPdfView(!isPdfView)}
                  className="px-3 py-1.5 rounded-xl text-xs font-mono bg-white/[0.04] border border-white/[0.08] text-purple-300 hover:text-white transition-colors"
                >
                  {isPdfView ? 'View Slides' : 'Toggle PDF'}
                </button>
                <button
                  onClick={() => setIsDeckOpen(false)}
                  className="text-neutral-400 hover:text-white p-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] transition-colors font-mono text-xs"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>
            </div>

            {/* Slide Body */}
            {isPdfView ? (
              <div className="py-6 flex-1 min-h-[420px]">
                <iframe 
                  src="/presentation/deck.pdf" 
                  title="AETHERIS Presentation PDF"
                  className="w-full h-[480px] rounded-2xl border border-white/[0.08] bg-black/60"
                />
              </div>
            ) : (
              <div className="py-6 space-y-6 flex-1">
                
                {/* Slide Title & Subtitle */}
                <div className="space-y-1.5">
                  <div className="text-xs font-mono text-purple-400 tracking-wider">
                    {currentSlide.stepName}
                  </div>
                  <h3 className="text-2xl sm:text-3xl font-display font-medium text-white tracking-[-0.01em]">
                    {currentSlide.title}
                  </h3>
                  <p className="text-xs sm:text-sm font-mono text-neutral-400">
                    {currentSlide.subtitle}
                  </p>
                </div>

                {/* 3 Core Bullet Points */}
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  {currentSlide.points.map((pt: string, idx: number) => (
                    <div key={idx} className="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] text-xs text-neutral-300 font-sans font-light flex items-start gap-2.5">
                      <span className="text-purple-400 font-mono font-medium">0{idx + 1}.</span>
                      <span className="leading-relaxed">{pt}</span>
                    </div>
                  ))}
                </div>

                {/* Code / Formula / Parameter Snippet */}
                {currentSlide.codeOrFormula && (
                  <div className="p-4 rounded-xl bg-black/60 border border-white/[0.08] font-mono text-xs text-purple-200 overflow-x-auto">
                    <pre className="whitespace-pre-wrap"><code>{currentSlide.codeOrFormula}</code></pre>
                  </div>
                )}

                {/* Pedagogical Takeaway Quote */}
                <div className="p-4 rounded-xl bg-purple-950/20 border border-purple-500/20 font-mono text-xs text-purple-200 flex items-center justify-between">
                  <span>💡 {currentSlide.takeaway}</span>
                  <span className="text-neutral-500 text-[10px]">GE931 AI 101</span>
                </div>

              </div>
            )}

            {/* Slide Navigation Footer */}
            <div className="border-t border-white/[0.06] pt-4 space-y-3">
              
              {/* Thumbnail Quick Stepper */}
              <div className="flex gap-1.5 overflow-x-auto pb-1 max-w-full">
                {DECK_SLIDES.map((s, idx) => (
                  <button
                    key={s.slideNumber}
                    onClick={() => {
                      setCurrentSlideIndex(idx);
                      setIsPdfView(false);
                    }}
                    className={`h-2 rounded-full transition-all flex-shrink-0 ${
                      currentSlideIndex === idx
                        ? 'w-7 bg-purple-400'
                        : 'w-2 bg-white/20 hover:bg-white/40'
                    }`}
                    title={`Slide ${s.slideNumber}: ${s.title}`}
                  />
                ))}
              </div>

              {/* Prev / Next Controls */}
              <div className="flex items-center justify-between">
                <span className="text-xs font-mono text-neutral-500">
                  Use ← and → arrow keys to navigate
                </span>

                <div className="flex items-center gap-3">
                  <button
                    disabled={currentSlideIndex === 0}
                    onClick={() => setCurrentSlideIndex(prev => Math.max(0, prev - 1))}
                    className="px-4 py-2 rounded-xl text-xs font-mono bg-white/[0.03] border border-white/[0.08] text-neutral-300 hover:text-white disabled:opacity-25 transition-colors flex items-center gap-1.5"
                  >
                    <ChevronLeft className="w-3.5 h-3.5" />
                    <span>Previous</span>
                  </button>
                  <button
                    disabled={currentSlideIndex === DECK_SLIDES.length - 1}
                    onClick={() => setCurrentSlideIndex(prev => Math.min(DECK_SLIDES.length - 1, prev + 1))}
                    className="px-4 py-2 rounded-xl text-xs font-mono bg-white text-black hover:bg-neutral-200 disabled:opacity-25 transition-colors font-medium flex items-center gap-1.5"
                  >
                    <span>Next Slide</span>
                    <ChevronRight className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

            </div>

          </div>
        </div>
      )}

      {/* ======================================================================
          ARCHITECTURAL LUXURY FOOTER
          ====================================================================== */}
      <footer className="pt-20 pb-12 bg-[#040308] border-t border-white/[0.08] relative overflow-hidden">
        {/* Subtle radial ambient backlights */}
        <div className="absolute bottom-0 left-1/4 w-96 h-96 rounded-full bg-purple-900/10 blur-[140px] pointer-events-none"></div>
        <div className="absolute bottom-0 right-1/4 w-96 h-96 rounded-full bg-amber-900/5 blur-[140px] pointer-events-none"></div>

        <div className="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10 space-y-16">
          
          {/* Main Footer Grid: 4 Columns */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
            
            {/* Column 1: Brand & Specimen Identity (4 cols) */}
            <div className="lg:col-span-4 space-y-5">
              <div className="flex items-center gap-3">
                <span className="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_10px_rgba(192,132,252,0.8)]"></span>
                <span className="text-base font-display font-medium tracking-[0.25em] text-white uppercase">AETHERIS</span>
              </div>
              <p className="text-xs font-mono uppercase tracking-widest text-neutral-400">
                Amethyst Ultrasonic Hardware Console
              </p>
              <p className="text-xs text-neutral-400 font-sans font-light leading-relaxed max-w-sm">
                Where authentic Uruguayan mineralogy converges with 2.4&nbsp;MHz cold cavitation fluidics and neuropharmacological cognitive ergonomics.
              </p>
              <div className="flex flex-wrap items-center gap-2 pt-1">
                <span className="text-[10px] font-mono uppercase tracking-widest px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.06] text-purple-300">
                  PZT // 2.4 MHZ
                </span>
                <span className="text-[10px] font-mono uppercase tracking-widest px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-300">
                  MOHS 7 AMETHYST
                </span>
                <span className="text-[10px] font-mono uppercase tracking-widest px-2.5 py-1 rounded bg-white/[0.03] border border-white/[0.06] text-neutral-300">
                  TI-6AL-4V BILLET
                </span>
              </div>
            </div>

            {/* Column 2: 6 Dimensions Pedagogical Architecture (3 cols) */}
            <div className="lg:col-span-3 space-y-4">
              <span className="text-[11px] font-mono uppercase tracking-[0.25em] text-neutral-300 block font-medium">
                6-Dimension Matrix
              </span>
              <ul className="space-y-2 text-xs font-mono">
                {DIMENSION_COMPARISONS.map((dim, idx) => (
                  <li key={dim.id}>
                    <button
                      onClick={() => {
                        setSelectedDimIndex(idx);
                        const el = document.getElementById('dimensions');
                        if (el) el.scrollIntoView({ behavior: 'smooth' });
                      }}
                      className="text-neutral-400 hover:text-purple-300 transition-colors text-left flex items-center gap-2 group"
                    >
                      <span className="text-[10px] text-neutral-600 group-hover:text-purple-400 transition-colors">0{idx + 1}</span>
                      <span className="font-light">{dim.title}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            {/* Column 3: System Engineering & Presentation (2 cols) */}
            <div className="lg:col-span-2 space-y-4">
              <span className="text-[11px] font-mono uppercase tracking-[0.25em] text-neutral-300 block font-medium">
                System Engineering
              </span>
              <ul className="space-y-2 text-xs font-mono text-neutral-400">
                <li>
                  <a href="#overview" className="hover:text-purple-300 transition-colors">
                    01 // Specimen Spotlight
                  </a>
                </li>
                <li>
                  <a href="#dimensions" className="hover:text-purple-300 transition-colors">
                    02 // 6-Dimension Matrix
                  </a>
                </li>
                <li>
                  <a href="#presentation-deck" className="hover:text-purple-300 transition-colors">
                    03 // Presentation Deck
                  </a>
                </li>
                <li>
                  <a href="#specifications" className="hover:text-purple-300 transition-colors">
                    04 // Technical Bento CMF
                  </a>
                </li>
              </ul>
              <div className="pt-2 space-y-2 border-t border-white/[0.04]">
                <button
                  onClick={() => setIsDeckOpen(true)}
                  className="text-xs font-mono text-purple-300 hover:text-purple-200 transition-colors flex items-center gap-1.5"
                >
                  <Presentation className="w-3.5 h-3.5" />
                  <span>Launch Deck (30)</span>
                </button>
                <a
                  href="/presentation/deck.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  className="text-xs font-mono text-neutral-400 hover:text-neutral-200 transition-colors flex items-center gap-1.5"
                >
                  <ExternalLink className="w-3.5 h-3.5" />
                  <span>PDF Document</span>
                </a>
              </div>
            </div>

            {/* Column 4: Academic Provenance (3 cols) */}
            <div className="lg:col-span-3 space-y-4">
              <span className="text-[11px] font-mono uppercase tracking-[0.25em] text-neutral-300 block font-medium">
                Academic Provenance
              </span>
              <div className="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-2 text-xs font-mono">
                <div className="text-[10px] text-purple-400 uppercase tracking-wider font-medium">
                  GE931 Introduction to AI
                </div>
                <div className="text-white font-medium">
                  Pakamas Kajornsri
                </div>
                <div className="text-neutral-400 text-[11px]">
                  Student ID: 2610717302062
                </div>
                <div className="text-neutral-500 text-[10px] leading-relaxed pt-1 border-t border-white/[0.04]">
                  B.Eng. Computer Engineering &amp; Artificial Intelligence
                </div>
              </div>
              <div className="text-[10px] font-mono text-neutral-400 uppercase tracking-widest">
                [ BU ACADEMIC SHOWCASE // 2026 ]
              </div>
            </div>

          </div>

          {/* Bottom Bar: Copyright, Telemetry, Back to Top */}
          <div className="pt-8 border-t border-white/[0.06] flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono">
            <div className="text-neutral-500 text-center md:text-left text-[11px]">
              &copy; 2026 AETHERIS Architectural Hardware Showcase. All rights reserved.
            </div>

            <div className="flex flex-wrap items-center justify-center gap-4 text-[10px] text-neutral-400 uppercase tracking-widest">
              <span>STATUS // OPERATIONAL</span>
              <span className="text-neutral-700">•</span>
              <span>AEROSOL // 3.2µM COLD MIST</span>
              <span className="text-neutral-700">•</span>
              <span>NOISE // &lt;12 DB</span>
            </div>

            <button
              onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })}
              className="px-3.5 py-1.5 rounded-full bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-purple-500/40 text-neutral-400 hover:text-white transition-all duration-300 flex items-center gap-2 text-[11px] group"
            >
              <span>Back to top</span>
              <ChevronUp className="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform" />
            </button>
          </div>

        </div>
      </footer>

    </div>
  );
}
