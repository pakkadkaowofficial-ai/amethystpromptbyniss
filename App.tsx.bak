// ============================================================================
// 4.5. RESILIENT ASSET IMAGE COMPONENT
// ============================================================================

export interface ResilientImageProps {
  webpSrc: string;
  fallbackSrc?: string;
  alt: string;
  className?: string;
}

export const ResilientImage: React.FC<ResilientImageProps> = ({
  webpSrc,
  fallbackSrc,
  alt,
  className = ''
}) => {
  const [currentSrc, setCurrentSrc] = useState<string>(webpSrc);
  const [hasTriedFallback, setHasTriedFallback] = useState<boolean>(false);
  const [loadFailed, setLoadFailed] = useState<boolean>(false);

  useEffect(() => {
    setCurrentSrc(webpSrc);
    setHasTriedFallback(false);
    setLoadFailed(false);
  }, [webpSrc, fallbackSrc]);

  const handleError = () => {
    if (fallbackSrc && !hasTriedFallback && currentSrc !== fallbackSrc) {
      setCurrentSrc(fallbackSrc);
      setHasTriedFallback(true);
    } else {
      setLoadFailed(true);
    }
  };

  if (loadFailed) {
    return (
      <div className="w-full h-full min-h-[160px] flex flex-col items-center justify-center p-4 bg-black/50 text-neutral-400 font-mono text-[11px] text-center border border-white/[0.04] rounded-xl">
        <span className="text-purple-400 text-xs mb-1 font-semibold">◈ TELEMETRY ASSET OFFLINE</span>
        <span className="text-[9px] text-neutral-500 uppercase tracking-widest">{alt}</span>
      </div>
    );
  }

  return (
    <picture className="w-full h-full block">
      <source srcSet={webpSrc} type="image/webp" />
      <img
        src={currentSrc}
        alt={alt}
        loading="lazy"
        onError={handleError}
        className={className}
      />
    </picture>
  );
};

// ============================================================================
// 5. MAIN APPLICATION COMPONENT
// ============================================================================

export default function App() {
  // Navigation & Spotlight State
  const [isPulseActive, setIsPulseActive] = useState<boolean>(true);
  const [rotationAngle, setRotationAngle] = useState<number>(15);
  const [isDragging, setIsDragging] = useState<boolean>(false);
  const [dragStartX, setDragStartX] = useState<number>(0);

  // 6-Dimension Comparative State
  const [selectedDimIndex, setSelectedDimIndex] = useState<number>(0);
  const [activeDimTab, setActiveDimTab] = useState<'both' | 'zero' | 'few'>('both');

  // Presentation Deck State (30 Slides)
  const [isDeckOpen, setIsDeckOpen] = useState<boolean>(false);
  const [currentSlideIndex, setCurrentSlideIndex] = useState<number>(0);
  const [isPdfView, setIsPdfView] = useState<boolean>(false);

  const currentDim = DIMENSION_COMPARISONS[selectedDimIndex];
  const currentSlide = DECK_SLIDES[currentSlideIndex];

  // Interactive 360° Mouse/Touch Rotation
  const handleMouseDown = (e: React.MouseEvent) => {
    setIsDragging(true);
    setDragStartX(e.clientX);
  };

  const handleMouseMove = (e: React.MouseEvent) => {
    if (!isDragging) return;
    const delta = e.clientX - dragStartX;
    setRotationAngle(prev => (prev + delta * 0.6) % 360);
    setDragStartX(e.clientX);
  };

  const handleMouseUp = () => {
    setIsDragging(false);
  };

  const handleTouchStart = (e: React.TouchEvent) => {
    if (e.touches.length > 0) {
      setIsDragging(true);
      setDragStartX(e.touches[0].clientX);
    }
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (!isDragging || e.touches.length === 0) return;
    const delta = e.touches[0].clientX - dragStartX;
    setRotationAngle(prev => (prev + delta * 0.6) % 360);
    setDragStartX(e.touches[0].clientX);
  };

  // Keyboard accessibility for modal
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (!isDeckOpen) return;
      if (e.key === 'Escape') setIsDeckOpen(false);
      if (e.key === 'ArrowRight') {
        setCurrentSlideIndex(prev => Math.min(DECK_SLIDES.length - 1, prev + 1));
      }
      if (e.key === 'ArrowLeft') {
        setCurrentSlideIndex(prev => Math.max(0, prev - 1));
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isDeckOpen]);

  return (
    <div className="min-h-screen bg-[#050409] text-slate-200 selection:bg-purple-600 selection:text-white font-sans antialiased overflow-x-hidden">
      
      {/* Dynamic Ambient Background Glow (Subtle & Diffused) */}
      <div 
        className="fixed inset-0 pointer-events-none transition-all duration-1000 z-0 opacity-25"
        style={{
          background: 'radial-gradient(circle at 50% 15%, rgba(168, 85, 247, 0.25) 0%, transparent 60%), radial-gradient(circle at 80% 80%, rgba(129, 140, 248, 0.15) 0%, transparent 50%)'
        }}
      />

      {/* ======================================================================
          NAVBAR & APPLICATION SHELL (LEICA / B&O AESTHETIC)
          ====================================================================== */}
      <header className="sticky top-0 z-40 backdrop-blur-2xl bg-[#050409]/85 border-b border-white/[0.06] transition-all duration-300">
        <div className="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
          
          {/* Brand Monomark & Status Badge */}
          <div className="flex items-center gap-6">
            <a href="#overview" className="group flex items-center gap-3.5">
              <div className="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500/20 to-purple-900/40 flex items-center justify-center border border-purple-500/30 group-hover:border-purple-400/60 transition-all duration-300">
                <span className="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.9)]"></span>
              </div>
              <div className="flex flex-col">
                <span className="text-sm font-display font-medium tracking-[0.25em] text-white uppercase group-hover:text-purple-200 transition-colors">AETHERIS</span>
                <span className="text-[9px] font-mono tracking-[0.2em] text-neutral-400 uppercase">Amethyst Ultrasonic Console</span>
              </div>
            </a>

            <div className="hidden md:block h-4 w-[1px] bg-white/[0.08]"></div>

            {/* Hairline Telemetry Status Badge */}
            <div className="hidden md:flex items-center gap-2.5 px-3 py-1 rounded-full bg-white/[0.02] border border-white/[0.06] text-[11px] font-mono tracking-widest text-neutral-300">
              <span className="relative flex h-1.5 w-1.5">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                <span className="relative inline-flex rounded-full h-1.5 w-1.5 bg-purple-400"></span>
              </span>
              <span className="text-[10px] text-purple-300/90 font-mono">[ 2.4 MHZ CAVITATION // ACTIVE ]</span>
            </div>
          </div>

          {/* Editorial Navigation Links */}
          <nav className="hidden lg:flex items-center gap-9 text-xs font-mono uppercase tracking-widest text-neutral-400">
            <a href="#overview" className="hover:text-white transition-colors duration-200">Overview</a>
            <a href="#dimensions" className="hover:text-white transition-colors duration-200">6×5 Matrix</a>
            <a href="#presentation-deck" className="hover:text-white transition-colors duration-200">Presentation Deck</a>
            <a href="#specifications" className="hover:text-white transition-colors duration-200">Bento Specs</a>
          </nav>

          {/* Action Button: Launch Presentation Deck */}
          <div className="flex items-center gap-4">
            <button
              onClick={() => setIsDeckOpen(true)}
              className="relative group px-4 py-2 rounded-full text-xs font-mono uppercase tracking-widest text-neutral-300 hover:text-white bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-purple-500/30 transition-all duration-300 flex items-center gap-2.5"
            >
              <Presentation className="w-3.5 h-3.5 text-purple-400" />
              <span>30 Slides</span>
              <span className="text-[10px] text-purple-300/80 font-mono bg-purple-950/60 px-2 py-0.5 rounded-full border border-purple-500/20">Deck</span>
            </button>
          </div>
        </div>
      </header>

      {/* ======================================================================
          HERO SECTION: ASYMMETRIC MINIMALIST HARDWARE SPOTLIGHT
          ====================================================================== */}
      <section id="overview" className="relative pt-16 pb-28 lg:pt-24 lg:pb-36 overflow-hidden">
        <div className="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
          
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
            
            {/* Left Narrative Column */}
            <div className="lg:col-span-6 space-y-9">
              
              {/* Minimalist Eyebrow Tag */}
              <div className="flex items-center gap-3">
                <span className="w-8 h-[1px] bg-purple-500/70 inline-block"></span>
                <span className="text-[11px] font-mono uppercase tracking-[0.3em] text-purple-300 font-medium">
                  [ SPECIMEN 01 // 2.4 MHZ CAVITATION ]
                </span>
              </div>

              {/* Airy Headline with Editorial Contrast */}
              <div className="space-y-4">
                <h1 className="text-4xl sm:text-5xl lg:text-[62px] font-display font-light text-white leading-[1.08] tracking-[-0.02em]">
                  WHERE RAW <span className="font-serif italic font-normal text-purple-300">Geology</span> TRANSCENDS COGNITIVE ERGONOMICS.
                </h1>
                <p className="text-base sm:text-lg text-neutral-400 font-sans font-light leading-relaxed max-w-xl">
                  Forged at the threshold of geological permanence and neurochemistry. A monolithic titanium chassis harnesses authentic Uruguayan amethyst cavities and 2.4 MHz acoustic cavitation, dispersing non-thermal terpene aerosols calibrated to sustain cognitive flow and eliminate prefrontal fatigue.
