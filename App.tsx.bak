              </div>

              {/* Micro-Telemetry Pills (3 Hairline Glass Badges) */}
              <div className="grid grid-cols-3 gap-3 pt-2">
                <div className="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-xl">
                  <span className="text-[10px] font-mono tracking-widest text-neutral-400 uppercase block">Mineral Cavity</span>
                  <span className="text-base font-mono font-medium text-white block mt-0.5">Mohs 7</span>
                  <span className="text-[10px] font-mono text-purple-400/80 block mt-0.5 tracking-wider">Raw Amethyst</span>
                </div>

                <div className="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-xl">
                  <span className="text-[10px] font-mono tracking-widest text-neutral-400 uppercase block">Aerosol Scale</span>
                  <span className="text-base font-mono font-medium text-white block mt-0.5">&lt; 3.8 µm</span>
                  <span className="text-[10px] font-mono text-amber-400/80 block mt-0.5 tracking-wider">Cold Micro-Mist</span>
                </div>

                <div className="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-xl">
                  <span className="text-[10px] font-mono tracking-widest text-neutral-400 uppercase block">Acoustics</span>
                  <span className="text-base font-mono font-medium text-white block mt-0.5">0 dB</span>
                  <span className="text-[10px] font-mono text-indigo-400/80 block mt-0.5 tracking-wider">Silent Cavitation</span>
                </div>
              </div>

              {/* Dual Minimal CTA */}
